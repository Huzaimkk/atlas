# Personal ingest — CVs, dropped leads, anything not yet resolved into the pool.
# Keep the folders themselves (and their READMEs) tracked; ignore everything dropped into them.
data/inbox/cv/*
data/inbox/leads/*
!data/inbox/cv/README.md
!data/inbox/leads/README.md

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — every variant, not just .local (the previous rule missed
# .env.production / .env.development if either ever gets created)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
